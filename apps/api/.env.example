NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=worknext-local-access-secret
JWT_REFRESH_SECRET=worknext-local-refresh-secret

STORAGE_DRIVER=local
LOCAL_DATA_FILE=.data/worknext.json
LOCAL_UPLOAD_DIR=.uploads

# Switch STORAGE_DRIVER to database when PostgreSQL is ready.
DATABASE_URL=postgresql://worknext:worknext@localhost:5432/worknext

REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=worknext
REDIS_PRESENCE_TTL_SECONDS=45
ENABLE_REDIS_ADAPTER=true
ENABLE_BULLMQ=true

EMAIL_DELIVERY_MODE=local
LOCAL_EMAIL_OUTBOX_FILE=.data/email-outbox.jsonl
EMAIL_FROM_ADDRESS=no-reply@worknext.local

PUSH_DELIVERY_MODE=local
LOCAL_PUSH_OUTBOX_FILE=.data/push-outbox.jsonl
