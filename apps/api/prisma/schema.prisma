generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum MessageType {
  TEXT
  SYSTEM
  FILE
}

enum NotificationType {
  MENTION
  DIGEST
}

enum DigestMode {
  OFF
  DAILY
}

model AuditLog {
  id                String   @id
  workspaceId       String
  actorUserId       String
  actorDisplayName  String
  action            String
  entityType        String
  entityId          String
  entityLabel       String?
  targetUserId      String?
  targetDisplayName String?
  metadata          Json?
  createdAt         DateTime

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, action, createdAt(sort: Desc)])
  @@index([workspaceId, actorUserId, createdAt(sort: Desc)])
}

model AppStateMeta {
  id        String   @id
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String                @id
  email              String                @unique
  passwordHash       String
  displayName        String
  createdAt          DateTime
  updatedAt          DateTime
  sessions           Session[]
  organizationMemberships OrganizationMembership[]
  memberships        WorkspaceMembership[]
  channelMemberships ChannelMembership[]
  sentInvites        Invitation[]          @relation("InvitationSender")
  messages           Message[]
  messageReactions   MessageReaction[]
  notificationPreferences NotificationPreference[]
  presence           Presence?
}

model Session {
  id                String   @id
  userId            String
  refreshTokenHash  String
  userAgent         String?
  ipAddress         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime
  updatedAt         DateTime
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id           String                   @id
  name         String
  slug         String                   @unique
  createdById  String
  createdAt    DateTime
  updatedAt    DateTime
  memberships  OrganizationMembership[]
  workspaces   Workspace[]
}

model OrganizationMembership {
  id             String        @id
  organizationId String
  userId         String
  role           WorkspaceRole @default(MEMBER)
  joinedAt       DateTime
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Workspace {
  id           String                @id
  organizationId String
  name         String
  slug         String                @unique
  createdById  String
  createdAt    DateTime
  updatedAt    DateTime
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  WorkspaceMembership[]
  invitations  Invitation[]
  channels     Channel[]

  @@index([organizationId])
}

model WorkspaceMembership {
  id           String        @id
  workspaceId  String
  userId       String
  role         WorkspaceRole @default(MEMBER)
  joinedAt     DateTime
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id             String        @id
  workspaceId    String
  email          String
  token          String        @unique
  role           WorkspaceRole @default(MEMBER)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy      User          @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

model Channel {
  id             String             @id
  workspaceId    String
  name           String
  description    String?
  type           ChannelType        @default(PUBLIC)
  createdById    String
  createdAt      DateTime
  updatedAt      DateTime
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships    ChannelMembership[]
  messages       Message[]

  @@unique([workspaceId, name])
  @@index([workspaceId, type])
}

model ChannelMembership {
  id         String   @id
  workspaceId String
  channelId   String
  userId      String
  addedById   String
  joinedAt    DateTime
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model ChannelReadState {
  id         String   @id
  workspaceId String
  channelId   String
  userId      String
  lastReadAt  DateTime
  updatedAt   DateTime

  @@unique([channelId, userId])
  @@index([workspaceId, userId])
}

model Message {
  id             String       @id
  workspaceId    String
  channelId      String
  senderId       String
  parentMessageId String?
  type           MessageType  @default(TEXT)
  content        String
  createdAt      DateTime
  updatedAt      DateTime
  deletedAt      DateTime?
  channel        Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parentMessage  Message?     @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  threadReplies  Message[]    @relation("MessageThread")
  reactions      MessageReaction[]
  attachments    FileAttachment[]

  @@index([channelId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([parentMessageId, createdAt(sort: Desc)])
}

model MessageReaction {
  id          String   @id
  workspaceId String
  channelId   String
  messageId   String
  userId      String
  emoji       String
  createdAt   DateTime
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([workspaceId, messageId])
  @@index([userId])
}

model FileAttachment {
  id           String   @id
  messageId    String?
  workspaceId  String
  uploaderId   String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  createdAt    DateTime
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Notification {
  id          String           @id
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String
  channelId   String
  messageId   String
  readAt      DateTime?
  createdAt   DateTime

  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, userId])
}

model NotificationPreference {
  id              String     @id
  workspaceId     String
  userId          String
  muteAll         Boolean    @default(false)
  allowMentions   Boolean    @default(true)
  emailMentions   Boolean    @default(false)
  emailDigest     Boolean    @default(false)
  pushMentions    Boolean    @default(false)
  pushDigest      Boolean    @default(false)
  mutedChannelIds String[]
  digestMode      DigestMode @default(OFF)
  lastDigestAt    DateTime?
  createdAt       DateTime
  updatedAt       DateTime
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model Presence {
  userId        String   @id
  status        String
  lastSeenAt    DateTime
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
