{
  "name": "@worknext/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -s first -n build,serve \"pnpm run dev:build\" \"pnpm run dev:serve\"",
    "dev:build": "nest build --watch",
    "dev:serve": "wait-on dist/apps/api/src/main.js && nodemon --watch dist/apps/api/src --ext js --signal SIGTERM --exec \"node dist/apps/api/src/main.js\"",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate:json-to-db": "node --loader ts-node/esm src/scripts/migrate-json-to-db.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.ts",
    "format": "prettier --check \"src/**/*.ts\" \"prisma/**/*.prisma\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/client": "^6.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.70.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "^8.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "wait-on": "^9.0.4"
  }
}
