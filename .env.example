# Copy this file to .env for the default local-first workflow.
# This profile runs without PostgreSQL and uses local JSON storage plus local uploads.

NODE_ENV=development
JWT_ACCESS_SECRET=worknext-local-access-secret
JWT_REFRESH_SECRET=worknext-local-refresh-secret
API_PORT=3001
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000

STORAGE_DRIVER=local
LOCAL_DATA_FILE=.data/worknext.json
LOCAL_UPLOAD_DIR=.uploads

# Optional PostgreSQL mode:
# STORAGE_DRIVER=database
DATABASE_URL=postgresql://worknext:worknext@localhost:5432/worknext

# Optional Redis-backed realtime and queue mode.
# Leave REDIS_URL empty to disable Redis-backed features.
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=worknext
REDIS_PRESENCE_TTL_SECONDS=45
ENABLE_REDIS_ADAPTER=true
ENABLE_BULLMQ=true

# Local delivery defaults are safe for development and keep output in local files.
EMAIL_DELIVERY_MODE=local
LOCAL_EMAIL_OUTBOX_FILE=.data/email-outbox.jsonl
EMAIL_FROM_ADDRESS=no-reply@worknext.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

PUSH_DELIVERY_MODE=local
LOCAL_PUSH_OUTBOX_FILE=.data/push-outbox.jsonl
PUSH_WEBHOOK_URL=
